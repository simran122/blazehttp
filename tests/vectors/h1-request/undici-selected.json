      "inputEncoding": "utf8",
      "request": {
        "method": "GET",
        "target": "/x",
        "templateHost": "127.0.0.1:3999",
        "templateFields": "",
        "headers": "content-type: application/json\r\n\r\nGET /foo2 HTTP/1.1\r\n",
        "headerLines": 1,
        "body": ""
      },
      "expect": {
        "error": "ENGINE/internal"
      },
