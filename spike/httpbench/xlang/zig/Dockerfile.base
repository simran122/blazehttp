FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq curl xz-utils ca-certificates >/dev/null && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL https://ziglang.org/download/0.17.1/zig-aarch64-linux-0.17.1.tar.xz | tar -xJ -C /opt \
 && ln -s /opt/zig-aarch64-linux-0.17.1/zig /usr/local/bin/zig
